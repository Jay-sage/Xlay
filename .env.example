# ==========================================
# XLAY ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================
# Copy this file to .env.local for local development.
# Never commit .env.local or secret keys to git.

# ------------------------------------------
# App & Deployment
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xiadouznnbpwrhfpqumh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only service role key (NEVER expose to client / NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------
# Snap Kit OAuth 2.0 (Phase 1)
# ------------------------------------------
# Snap Developer Portal: https://kit.snapchat.com
# Redirect URIs:
#   Local: http://localhost:3000/auth/callback
#   Production: https://xlay.me/auth/callback
SNAP_CLIENT_ID="your-snap-client-id"
SNAP_CLIENT_SECRET="your-snap-client-secret"
SNAP_OAUTH_REDIRECT_URI="http://localhost:3000/auth/callback"

# ------------------------------------------
# Feature Flags (Defaults to OFF)
# ------------------------------------------
FEATURE_PAYSTACK=false
FEATURE_BREVO_SMTP=false

# ------------------------------------------
# Third-party Integrations (Phase 2 & 3 - Off by default)
# ------------------------------------------
# PAYSTACK_SECRET_KEY="sk_test_..."
# PAYSTACK_PUBLIC_KEY="pk_test_..."
# BREVO_SMTP_KEY="..."
